{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Port": 5000,
  "DB_HOST": "localhost",
  "DB_USER": "",
  "DB_PASSWORD": "",
  "DB_AUTO_MIGRATE": "false",
  "DB_NAME": "nexuscore",
  "JWT_EXPIRES_IN": "7d",
  "FREE_CLOUD_SLOTS": 3,
  "RateLimiting": {
    "GlobalPermitLimit": 300,
    "GlobalWindowSeconds": 60,
    "SensitivePermitLimit": 10,
    "SensitiveWindowSeconds": 60,
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60,
    "AgentPermitLimit": 180,
    "AgentWindowSeconds": 60
  },
  "Resilience": {
    "RemoteImageProbe": {
      "TotalTimeoutMs": 10000,
      "AttemptTimeoutMs": 3000,
      "MaxRetries": 2,
      "RetryDelayMs": 300,
      "BreakerFailureRatio": 0.5,
      "BreakerMinimumThroughput": 5,
      "BreakerSamplingMs": 30000,
      "BreakDurationMs": 30000
    }
  }
}
