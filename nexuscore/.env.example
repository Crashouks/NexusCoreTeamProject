PORT=5000
WEB_PORT=5173
DB_HOST=localhost
# Use the least-privilege account from database/provision-users.sh (never root).
# Create the schema first with database/migrate.sh. See database/README.md.
DB_USER=nexuscore_app
DB_PASSWORD=
DB_PORT=3306
# DB_SSL_MODE=Required   # defaults to Required for non-local hosts
DB_AUTO_MIGRATE=false
DB_NAME=nexuscore
# REQUIRED outside Development: >= 32 random chars, e.g. `openssl rand -base64 48`.
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
# Optional (defaults: nexuscore-api / nexuscore-client)
# JWT_ISSUER=nexuscore-api
# JWT_AUDIENCE=nexuscore-client

# Comma-separated IPs of reverse proxies whose X-Forwarded-For header may be trusted
# (loopback is always trusted). Needed for per-client rate limiting behind Docker/nginx.
# TRUSTED_PROXIES=
JWT_EXPIRES_IN=1d
FREE_CLOUD_SLOTS=3

# --- Remote access (Tailscale / LAN) ---
# Use start-site-network.bat (HTTP) or start-site-https.bat (HTTPS via Tailscale Serve)
# Split agent on another PC (3 laptops): set PUBLIC_* to URLs reachable from that PC

# Bind API on all interfaces when NETWORK_MODE=1 (set by start-site-network.bat)
# API_BIND=0.0.0.0
# NETWORK_MODE=1

# HTTPS via Tailscale Serve (set automatically by start-site-https.bat)
# HTTPS_MODE=1

# Public URLs — required for cloud agent on another machine/network.
# Examples:
#   Tailscale HTTP:  PUBLIC_WEB_URL=http://100.x.x.x:5173
#   Tailscale HTTPS: PUBLIC_WEB_URL=https://your-pc.tail1234.ts.net  (use start-site-https.bat)
#   LAN test:        leave empty — start-site-network.bat auto-detects your IP
PUBLIC_API_URL=
PUBLIC_WEB_URL=

# Optional: more browser origins allowed to open the SignalR hub / call the API with credentials
# (comma-separated), e.g. the same PC reached by Tailscale IP *and* MagicDNS name.
# CORS_EXTRA_ORIGINS=http://100.x.x.x:5173,https://your-pc.tail1234.ts.net
