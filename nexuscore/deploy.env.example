# Copy to ".env" on the server (it is git-ignored). NEVER commit the real file.
# Use URL-safe secrets (no ; = " characters), e.g.: openssl rand -hex 24

# Two hostnames pointing at the server's public IP (A/AAAA records) - or both through a tunnel.
# Use sibling subdomains of ONE domain: the auth cookie is SameSite=Lax, so the frontend and API
# must be "same-site" (app.example.com + api.example.com) for login to work.
WEB_DOMAIN=app.example.com
API_DOMAIN=api.example.com

# Use URL-safe random passwords (openssl rand -hex 24). DB passwords must be 16-128 characters.
DB_ROOT_PASSWORD=change_me_root_password
DB_PASSWORD=change_me_app_password
NEXUSCORE_MIGRATOR_PASSWORD=change_me_migrator_password
# >= 32 chars, required outside Development:  openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1d

# Only used to name/pull images from Docker Hub (optional)
DOCKERHUB_USER=your_dockerhub_username
TAG=v1.0.0
