# Copy to .env on the server and replace every placeholder. Never commit the real file.
# Generate distinct DB secrets and a 32+ character JWT secret with: openssl rand -hex 32

# These should be sibling subdomains of one domain (SameSite=Lax auth cookie).
WEB_DOMAIN=app.example.com
API_DOMAIN=api.example.com

# Use URL-safe random passwords (openssl rand -hex 24). DB passwords must be 16-128 characters.
DB_ROOT_PASSWORD=change_me_root_password
DB_PASSWORD=change_me_app_password
NEXUSCORE_MIGRATOR_PASSWORD=change_me_migrator_password
# >= 32 chars, required outside Development:  openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1d

# Must match the GitHub Actions Docker Hub account if pulling published images.
DOCKERHUB_USERNAME=your_dockerhub_username
TAG=latest
