@@ -0,0 +19 @@
+using Microsoft.AspNetCore.SignalR;
+using NexusCore.Api.Authentication;
+using NexusCore.Api.Contracts;
+
+namespace NexusCore.Api.Hubs;
+
+[AgentAuth]
+public class StreamingAgentHub : Hub
+{
+    public async Task ReportMetrics(AgentStatusReportDto metrics)
+    {
+        await Clients.Caller.SendAsync("MetricsAcknowledged", DateTime.UtcNow);
+    }
+
+    public async Task NotifyTermination(string sessionId, string reason)
+    {
+        await Clients.Group(sessionId).SendAsync("StreamTerminated", reason);
+    }
+}