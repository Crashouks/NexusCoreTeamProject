+namespace NexusCore.Api.Contracts;
+
+public class StreamConfigurationDto
+{
+    public string SessionId { get; set; } = string.Empty;
+    public string UserId { get; set; } = string.Empty;
+    public VideoQualitySettingsDto VideoSettings { get; set; } = new();
+    public InputMappingSettingsDto InputSettings { get; set; } = new();
+}
+
+public class VideoQualitySettingsDto
+{
+    public string TargetResolution { get; set; } = "1920x1080";
+    public int TargetFps { get; set; } = 60;
+    public int MaxBitrateKbps { get; set; } = 15000;
+    public string Codec { get; set; } = "H264";
+    public bool EnableHardwareAcceleration { get; set; } = true;
+}
+
+public class InputMappingSettingsDto
+{
+    public string MouseMode { get; set; } = "Relative";
+    public bool EnableGamepad { get; set; } = true;
+}
+
+public class AgentStatusReportDto
+{
+    public string AgentId { get; set; } = string.Empty;
+    public string SessionId { get; set; } = string.Empty;
+    public double CpuUsagePercent { get; set; }
+    public double GpuUsagePercent { get; set; }
+    public long MemoryUsageMb { get; set; }
+    public double CurrentFps { get; set; }
+}
+
+public class StreamTerminationRequestDto
+{
+    public string SessionId { get; set; } = string.Empty;
+    public string AgentId { get; set; } = string.Empty;
+    public string Reason { get; set; } = string.Empty;
+}
