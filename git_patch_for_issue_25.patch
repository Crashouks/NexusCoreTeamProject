+using Microsoft.AspNetCore.Mvc;
+using NexusCore.Api.Authentication;
+using NexusCore.Api.Contracts;
+
+namespace NexusCore.Api.Controllers;
+
+[ApiController]
+[Route("api/v1/agent")]
+[AgentAuth]
+public class StreamingAgentController : ControllerBase
+{
+    [HttpGet("session/{sessionId}/config")]
+    public ActionResult<StreamConfigurationDto> GetSessionConfig(string sessionId)
+    {
+        var config = new StreamConfigurationDto
+        {
+            SessionId = sessionId,
+            UserId = "user_default"
+        };
+        return Ok(config);
+    }
+
+    [HttpPost("status")]
+    public IActionResult ReportStatus([FromBody] AgentStatusReportDto report)
+    {
+        if (!ModelState.IsValid)
+        {
+            return BadRequest(ModelState);
+        }
+        return Accepted(new { status = "accepted" });
+    }
+
+    [HttpPost("terminate")]
+    public IActionResult TerminateStream([FromBody] StreamTerminationRequestDto request)
+    {
+        return Ok(new { status = "terminated" });
+    }
+}
