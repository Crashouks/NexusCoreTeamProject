diff --git a/nexuscore/database/README.md b/nexuscore/database/README.md
new file mode 100644
index 0000000..ad892ae
--- /dev/null
+++ b/nexuscore/database/README.md
@@ -0,0 +1,45 @@
+# NexusCore database (MySQL 8)
+
+| File | Run by | Purpose |
+|---|---|---|
+| `provision-users.sh` | MySQL admin, once | Creates the DB and two accounts: `nexuscore_migrator` (DDL) and `nexuscore_app` (SELECT/INSERT/UPDATE/DELETE only) |
+| `migrate.sh` | migrator account | Applies `migrations/V*.sql` once each, tracked with checksums in `schema_migrations` |
+| `migrations/V001` | | Baseline schema (users, games, libraries, cloud_sessions, ...) |
+| `migrations/V002` | | Foreign keys, CHECK constraints, indexes |
+| `migrations/V003` | | Seed: 8-game catalog + cloud plans (no user accounts) |
+
+## Fresh server (e.g. Kali)
+
+    sudo apt install mysql-server && sudo systemctl enable --now mysql
+    export NEXUSCORE_APP_PASSWORD='<16+ chars, A-Za-z0-9_@%+=.,:->'
+    export NEXUSCORE_MIGRATOR_PASSWORD='<different 16+ chars>'
+    sudo -E ./provision-users.sh     # root over the local socket
+    ./migrate.sh
+
+If the API runs on another machine: `ACCOUNT_HOST=<api-ip> REQUIRE_SSL=1 sudo -E ./provision-users.sh`
+and run `migrate.sh` with `DB_HOST=<mysql-host>`; also allow port 3306 only from the API host.
+
+## Point the API at it (`nexuscore/.env`)
+
+    DB_HOST=<host>
+    DB_USER=nexuscore_app
+    DB_PASSWORD=<NEXUSCORE_APP_PASSWORD>
+    DB_AUTO_MIGRATE=false
+
+The API refuses to start as `root` or with an empty password, and at startup only checks
+that `schema_migrations` is at `V003` or newer. Check `GET /api/health/db`.
+
+## First admin
+
+Register in the app, then once as an administrator:
+`UPDATE users SET role='admin' WHERE email='you@example.com';`
+
+## Changing the schema
+
+Add `migrations/V004__what_changed.sql` and run `migrate.sh`. Never edit an applied file.
+Bump `RequiredSchemaVersion` in `MigrationService.cs` when the API needs the new version.
+
+## Note on the old scripts
+
+`seed.js`/`schema.sql` still work for throwaway local setups, but `seed.js` connects as root and creates
+`admin@nexuscore.com / admin123`. Do not use it on a shared or public server.
diff --git a/nexuscore/database/migrate.sh b/nexuscore/database/migrate.sh
new file mode 100755
index 0000000..32ceefb
--- /dev/null
+++ b/nexuscore/database/migrate.sh
@@ -0,0 +1,43 @@
+#!/usr/bin/env bash
+# Applies database/migrations/V*.sql in order, exactly once each, as the migrator account.
+#   NEXUSCORE_MIGRATOR_PASSWORD=... ./migrate.sh
+# Applied versions and SHA-256 checksums are stored in schema_migrations; editing an
+# already-applied file aborts the run (add a new V00N file instead).
+set -euo pipefail
+
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+DB_NAME="${DB_NAME:-nexuscore}"
+MIGRATOR_USER="${MIGRATOR_USER:-nexuscore_migrator}"
+DB_HOST="${DB_HOST:-127.0.0.1}"
+DB_PORT="${DB_PORT:-3306}"
+: "${NEXUSCORE_MIGRATOR_PASSWORD:?NEXUSCORE_MIGRATOR_PASSWORD is required}"
+
+# Keep the password out of the process list.
+CNF="$(mktemp)"; trap 'rm -f "$CNF"' EXIT; chmod 600 "$CNF"
+printf '[client]\nuser=%s\npassword=%s\nhost=%s\nport=%s\n' \
+  "$MIGRATOR_USER" "$NEXUSCORE_MIGRATOR_PASSWORD" "$DB_HOST" "$DB_PORT" > "$CNF"
+sql() { mysql --defaults-extra-file="$CNF" --default-character-set=utf8mb4 "$DB_NAME" "$@"; }
+
+sql -e "CREATE TABLE IF NOT EXISTS schema_migrations (
+  version     VARCHAR(20)  PRIMARY KEY,
+  description VARCHAR(200) NOT NULL,
+  checksum    CHAR(64)     NOT NULL,
+  applied_at  DATETIME     NOT NULL DEFAULT CURRENT_TIMESTAMP
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4"
+
+shopt -s nullglob
+applied=0
+for f in "$HERE"/migrations/V*.sql; do
+  base="$(basename "$f" .sql)"; version="${base%%__*}"; desc="${base#*__}"; desc="${desc//_/ }"
+  sum="$(sha256sum "$f" | cut -d' ' -f1)"
+  old="$(sql -N -B -e "SELECT checksum FROM schema_migrations WHERE version='${version}'")"
+  if [[ -n "$old" ]]; then
+    [[ "$old" == "$sum" ]] || { echo "ERROR: $base changed after it was applied" >&2; exit 1; }
+    echo "skip   $base"; continue
+  fi
+  echo "apply  $base"
+  sql < "$f"
+  sql -e "INSERT INTO schema_migrations (version, description, checksum) VALUES ('${version}', '${desc}', '${sum}')"
+  applied=$((applied+1))
+done
+echo "Done. ${applied} migration(s) applied."
diff --git a/nexuscore/database/migrations/V001__baseline_schema.sql b/nexuscore/database/migrations/V001__baseline_schema.sql
new file mode 100644
index 0000000..5606b5a
--- /dev/null
+++ b/nexuscore/database/migrations/V001__baseline_schema.sql
@@ -0,0 +1,314 @@
+-- V001: baseline schema (MySQL 8.0+)
+-- Consolidates schema.sql plus every table/column the API used to create at
+-- startup (chat, forum, notifications, cloud servers, agent jobs).
+-- Idempotent (IF NOT EXISTS) so it can be applied over a database that was
+-- created with the old schema.sql. Run by the migrator account, never by the app.
+
+CREATE TABLE IF NOT EXISTS users (
+  user_id               INT PRIMARY KEY AUTO_INCREMENT,
+  username              VARCHAR(50)  UNIQUE NOT NULL,
+  email                 VARCHAR(100) UNIQUE NOT NULL,
+  password              VARCHAR(255) NOT NULL,
+  avatar_url            VARCHAR(255),
+  bio                   TEXT,
+  country               VARCHAR(50)  DEFAULT '',
+  reg_date              DATETIME     DEFAULT NOW(),
+  balance               DECIMAL(10,2) DEFAULT 0.00,
+  role                  ENUM('user','developer','admin') DEFAULT 'user',
+  cloud_plan            ENUM('none','free','starter','pro','ultimate') DEFAULT 'free',
+  cloud_plan_expires    DATETIME,
+  cloud_free_used_today BOOLEAN  DEFAULT FALSE,
+  cloud_free_reset_at   DATETIME,
+  developer_company          VARCHAR(100),
+  developer_requested_at     DATETIME,
+  is_developer_approved      BOOLEAN DEFAULT FALSE
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
+
+CREATE TABLE IF NOT EXISTS games (
+  game_id          INT PRIMARY KEY AUTO_INCREMENT,
+  name             VARCHAR(150) NOT NULL,
+  slug             VARCHAR(150) UNIQUE,
