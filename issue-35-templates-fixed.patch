diff --git a/Dockerfile b/Dockerfile
new file mode 100644
index 0000000..c5efb21
--- /dev/null
+++ b/Dockerfile
@@ -0,0 +1,24 @@
+# Build Stage
+FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
+WORKDIR /src
+
+# Copy csproj and restore dependencies
+COPY ["NexusCore/NexusCore.csproj", "NexusCore/"]
+RUN dotnet restore "NexusCore/NexusCore.csproj"
+
+# Copy the rest of the code and build
+COPY . .
+WORKDIR "/src/NexusCore"
+RUN dotnet build "NexusCore.csproj" -c Release -o /app/build
+
+# Publish Stage
+FROM build AS publish
+RUN dotnet publish "NexusCore.csproj" -c Release -o /app/publish /p:UseAppHost=false
+
+# Runtime Stage
+FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
+WORKDIR /app
+EXPOSE 8080
+
+USER app
+
+COPY --from=publish /app/publish .
+ENTRYPOINT ["dotnet", "NexusCore.dll"]
diff --git a/docker-compose.yml b/docker-compose.yml
new file mode 100644
index 0000000..7b63f82
--- /dev/null
+++ b/docker-compose.yml
@@ -0,0 +1,38 @@
+version: '3.8'
+
+services:
+  nexuscore-api:
+    image: ${DOCKER_REGISTRY:-docker.io}/${DOCKER_USERNAME:-yourusername}/nexuscore-api:${APP_VERSION:-1.0.0}
+    build:
+      context: .
+      dockerfile: Dockerfile
+    container_name: nexuscore-api
+    ports:
+      - "8080:8080"
+    environment:
+      - ASPNETCORE_ENVIRONMENT=Production
+      - ConnectionStrings__DefaultConnection=Server=nexuscore-db;Port=3306;Database=${DB_NAME};Uid=${DB_USER};Pwd=${DB_PASSWORD};
+    depends_on:
+      nexuscore-db:
+        condition: service_healthy
+    networks:
+      - nexuscore-network
+    restart: unless-stopped
+
+  nexuscore-db:
+    image: mysql:8.0
+    container_name: nexuscore-db
+    environment:
+      MYSQL_ROOT_PASSWORD: ${DB_ROOT_PASSWORD}
+      MYSQL_DATABASE: ${DB_NAME}
+      MYSQL_USER: ${DB_USER}
+      MYSQL_PASSWORD: ${DB_PASSWORD}
+    ports:
+      - "3306:3306"
+    volumes:
+      - nexuscore-db-data:/var/lib/mysql
+    networks:
+      - nexuscore-network
+    healthcheck:
+      test: ["CMD", "mysqladmin" ,"ping", "-h", "localhost"]
+      timeout: 10s
+      retries: 10
+    restart: unless-stopped
+
+networks:
+  nexuscore-network:
+    driver: bridge
+
+volumes:
+  nexuscore-db-data:
