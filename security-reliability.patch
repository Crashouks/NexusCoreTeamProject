diff --git a/nexuscore/NexusCore.Api/Resilience/ImageUrlProbe.cs b/nexuscore/NexusCore.Api/Resilience/ImageUrlProbe.cs
new file mode 100644
index 0000000..7dd43dc
--- /dev/null
+++ b/nexuscore/NexusCore.Api/Resilience/ImageUrlProbe.cs
@@ -0,0 +1,84 @@
+using System.Net;
+using Polly.CircuitBreaker;
+using Polly.Timeout;
+
+namespace NexusCore.Api.Resilience;
+
+public enum ProbeStatus
+{
+    /// <summary>Reachable and Content-Type is image/*.</summary>
+    Image,
+    /// <summary>Reachable but not an image.</summary>
+    NotImage,
+    /// <summary>Malformed URL, non-http(s), or contains credentials.</summary>
+    InvalidUrl,
+    /// <summary>Destination is private/loopback/link-local (SSRF guard).</summary>
+    Blocked,
+    /// <summary>Connection failed or remote returned an error after all retries.</summary>
+    Unreachable,
+    /// <summary>Timeout elapsed (per-attempt or total).</summary>
+    TimedOut,
+    /// <summary>Circuit breaker is open: the request was not even attempted.</summary>
+    CircuitOpen,
+}
+
+public sealed record ProbeResult(ProbeStatus Status, string? ContentType = null, int? RetryAfterSeconds = null);
+
+public interface IImageUrlProbe
+{
+    Task<ProbeResult> ProbeAsync(string url, CancellationToken cancellationToken = default);
+}
+
+/// <summary>
+/// Checks that a remote URL serves an image using a HEAD request. The injected <see cref="HttpClient"/>
+/// is wrapped by the Timeout + Retry + Circuit Breaker pipeline registered in
+/// <see cref="ResilienceExtensions.AddRemoteImageProbe"/>; this class only translates the
+/// outcomes/exceptions into a <see cref="ProbeResult"/>.
+/// </summary>
+public sealed class ImageUrlProbe(HttpClient http, RemoteProbeOptions options) : IImageUrlProbe
+{
+    public async Task<ProbeResult> ProbeAsync(string url, CancellationToken cancellationToken = default)
+    {
+        if (!Uri.TryCreate(url, UriKind.Absolute, out var uri)
+            || uri.Scheme is not ("http" or "https")
+            || !string.IsNullOrEmpty(uri.UserInfo))
+            return new ProbeResult(ProbeStatus.InvalidUrl);
+
+        if (IPAddress.TryParse(uri.Host.Trim('[', ']'), out var literal) && !RemoteUrlGuard.IsPublicAddress(literal))
+            return new ProbeResult(ProbeStatus.Blocked);
+
+        try
+        {
+            using var request = new HttpRequestMessage(HttpMethod.Head, uri);
+            using var response = await http.SendAsync(request, HttpCompletionOption.ResponseHeadersRead, cancellationToken);
+
+            if (!response.IsSuccessStatusCode)
+                return new ProbeResult(ProbeStatus.Unreachable);
+
+            var contentType = response.Content.Headers.ContentType?.MediaType ?? "";
+            return contentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase)
+                ? new ProbeResult(ProbeStatus.Image, contentType)
+                : new ProbeResult(ProbeStatus.NotImage, contentType);
+        }
+        catch (BrokenCircuitException)
+        {
+            return new ProbeResult(ProbeStatus.CircuitOpen, RetryAfterSeconds: (int)Math.Ceiling(options.BreakDurationMs / 1000.0));
+        }
+        catch (TimeoutRejectedException)
+        {
+            return new ProbeResult(ProbeStatus.TimedOut);
+        }
+        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
+        {
+            throw; // the caller went away - not a dependency failure
+        }
+        catch (TaskCanceledException)
+        {
+            return new ProbeResult(ProbeStatus.TimedOut); // HttpClient.Timeout safety net
+        }
+        catch (HttpRequestException ex)
+        {
+            return new ProbeResult(RemoteUrlGuard.IsBlocked(ex) ? ProbeStatus.Blocked : ProbeStatus.Unreachable);
+        }
+    }
+}
diff --git a/nexuscore/NexusCore.Api/Resilience/RemoteUrlGuard.cs b/nexuscore/NexusCore.Api/Resilience/RemoteUrlGuard.cs
new file mode 100644
index 0000000..d2d4465
--- /dev/null
+++ b/nexuscore/NexusCore.Api/Resilience/RemoteUrlGuard.cs
@@ -0,0 +1,74 @@
+using System.Net;
+using System.Net.Sockets;
+
+namespace NexusCore.Api.Resilience;
+
+/// <summary>Thrown when an outbound request is refused because it targets a non-public address (SSRF guard).</summary>
+public sealed class BlockedDestinationException(string message) : HttpRequestException(message);
+
+/// <summary>
+/// SSRF protection for outbound requests to user-supplied URLs. The check is enforced at
+/// connect time (after DNS resolution), so DNS-rebinding and redirects to internal hosts are covered too.
+/// </summary>
+public static class RemoteUrlGuard
+{
+    public static bool IsBlocked(Exception? ex)
+    {
+        for (; ex != null; ex = ex.InnerException)
+            if (ex is BlockedDestinationException) return true;
+        return false;
+    }
+
+    /// <summary>True only for globally routable unicast addresses.</summary>
+    public static bool IsPublicAddress(IPAddress address)
+    {
+        if (address.IsIPv4MappedToIPv6) address = address.MapToIPv4();
+        if (IPAddress.IsLoopback(address) || address.Equals(IPAddress.Any) || address.Equals(IPAddress.IPv6Any))
+            return false;
+
+        if (address.AddressFamily == AddressFamily.InterNetworkV6)
+        {
+            if (address.IsIPv6LinkLocal || address.IsIPv6SiteLocal || address.IsIPv6Multicast || address.IsIPv6UniqueLocal)
+                return false;
+            return true;
+        }
+
+        if (address.AddressFamily != AddressFamily.InterNetwork) return false;
+
+        var b = address.GetAddressBytes();
+        return !(b[0] == 0                                   // 0.0.0.0/8
+              || b[0] == 10                                  // 10.0.0.0/8
+              || (b[0] == 100 && b[1] >= 64 && b[1] <= 127)  // 100.64.0.0/10 CGNAT (also Tailscale)
+              || b[0] == 127                                 // loopback
+              || (b[0] == 169 && b[1] == 254)                // link-local, cloud metadata 169.254.169.254
+              || (b[0] == 172 && b[1] >= 16 && b[1] <= 31)   // 172.16.0.0/12
+              || (b[0] == 192 && b[1] == 168)                // 192.168.0.0/16
+              || (b[0] == 192 && b[1] == 0 && b[2] == 0)     // 192.0.0.0/24
+              || (b[0] == 198 && (b[1] == 18 || b[1] == 19)) // benchmarking
+              || b[0] >= 224);                               // multicast + reserved
+    }
+
+    /// <summary>
+    /// <see cref="SocketsHttpHandler.ConnectCallback"/> that resolves the host itself, refuses to
+    /// connect to non-public addresses, and connects to the exact address it validated.
+    /// </summary>
+    public static async ValueTask<Stream> GuardedConnectAsync(SocketsHttpConnectionContext context, CancellationToken ct)
+    {
+        var addresses = await Dns.GetHostAddressesAsync(context.DnsEndPoint.Host, ct);
+        var allowed = addresses.Where(IsPublicAddress).ToArray();
+        if (allowed.Length == 0)
+            throw new BlockedDestinationException("Destination address is not allowed");
+
+        var socket = new Socket(SocketType.Stream, ProtocolType.Tcp) { NoDelay = true };
+        try
+        {
+            await socket.ConnectAsync(allowed, context.DnsEndPoint.Port, ct);
+            return new NetworkStream(socket, ownsSocket: true);
+        }
+        catch
+        {
+            socket.Dispose();
+            throw;
+        }
+    }
+}
diff --git a/nexuscore/NexusCore.Api/Resilience/ResilienceExtensions.cs b/nexuscore/NexusCore.Api/Resilience/ResilienceExtensions.cs
new file mode 100644
index 0000000..123ad82
--- /dev/null
+++ b/nexuscore/NexusCore.Api/Resilience/ResilienceExtensions.cs
@@ -0,0 +1,134 @@
+using System.Net;
+using Microsoft.Extensions.Http.Resilience;
+using Polly;
+using Polly.Retry;
+using Polly.Timeout;
+
+namespace NexusCore.Api.Resilience;
+
+/// <summary>
+/// Tunables for calls to external image hosts. Bound from "Resilience:RemoteImageProbe".
+/// Times are in milliseconds so tests can shrink them.
+/// </summary>
+public sealed class RemoteProbeOptions
+{
+    /// <summary>Upper bound for the whole operation, including all retries and back-off delays.</summary>
+    public int TotalTimeoutMs { get; set; } = 10_000;
+
+    /// <summary>Upper bound for one HTTP attempt.</summary>
+    public int AttemptTimeoutMs { get; set; } = 3_000;
+
+    /// <summary>Retries after the first attempt (0 disables retry).</summary>
+    public int MaxRetries { get; set; } = 2;
+
+    /// <summary>Base delay; doubled on every retry (exponential back-off) with jitter.</summary>
+    public int RetryDelayMs { get; set; } = 300;
+
+    /// <summary>Open the circuit when this share of calls within the sampling window failed...</summary>
+    public double BreakerFailureRatio { get; set; } = 0.5;
+
+    /// <summary>...and at least this many calls were made in that window.</summary>
+    public int BreakerMinimumThroughput { get; set; } = 5;
+
+    public int BreakerSamplingMs { get; set; } = 30_000;
+
+    /// <summary>How long the circuit stays open before a single trial request is let through (half-open).</summary>
+    public int BreakDurationMs { get; set; } = 30_000;
+}
+
+public static class ResilienceExtensions
+{
+    public const string ImageProbePipeline = "remote-image-probe";
+
+    /// <summary>
+    /// Registers <see cref="IImageUrlProbe"/> with an SSRF-safe handler and the resilience pipeline
+    /// (outermost to innermost): total Timeout -> Retry -> Circuit Breaker -> per-attempt Timeout.
+    /// Backed by Polly v8 via Microsoft.Extensions.Http.Resilience.
+    /// </summary>
+    public static IHttpClientBuilder AddRemoteImageProbe(this IServiceCollection services, RemoteProbeOptions o)
+    {
+        services.AddSingleton(o);
+
+        var client = services.AddHttpClient<IImageUrlProbe, ImageUrlProbe>(c =>
+        {
+            // Polly owns the timeouts; this is only a last-resort safety net above them.
+            c.Timeout = TimeSpan.FromMilliseconds(o.TotalTimeoutMs + 5_000);
+        });
+
+        client.ConfigurePrimaryHttpMessageHandler(() => new SocketsHttpHandler
+        {
+            ConnectCallback = RemoteUrlGuard.GuardedConnectAsync, // SSRF guard, enforced on every hop
+            UseProxy = false,
+            AllowAutoRedirect = true,
+            MaxAutomaticRedirections = 3,
+            ConnectTimeout = TimeSpan.FromMilliseconds(Math.Min(o.AttemptTimeoutMs, 3_000)),
+            PooledConnectionLifetime = TimeSpan.FromMinutes(2),
+        });
+
+        client.AddResilienceHandler(ImageProbePipeline, pipeline =>
+        {
+            // 1. Timeout - total budget for the whole call, retries included.
+            pipeline.AddTimeout(new HttpTimeoutStrategyOptions
+            {
+                Name = "total-timeout",
+                Timeout = TimeSpan.FromMilliseconds(o.TotalTimeoutMs),
+            });
+
+            // 2. Retry - only transient failures; HEAD is idempotent so repeating it is safe.
+            if (o.MaxRetries > 0)
+            {
+                pipeline.AddRetry(new HttpRetryStrategyOptions
+                {
+                    Name = "retry",
+                    MaxRetryAttempts = o.MaxRetries,
+                    Delay = TimeSpan.FromMilliseconds(o.RetryDelayMs),
+                    BackoffType = DelayBackoffType.Exponential,
+                    UseJitter = true,
+                    ShouldHandle = args => ValueTask.FromResult(IsTransientFailure(args.Outcome)),
+                });
+            }
+
+            // 3. Circuit Breaker - stop hammering a failing host; closed -> open -> half-open -> closed.
+            pipeline.AddCircuitBreaker(new HttpCircuitBreakerStrategyOptions
+            {
+                Name = "circuit-breaker",
+                FailureRatio = o.BreakerFailureRatio,
+                MinimumThroughput = o.BreakerMinimumThroughput,
+                SamplingDuration = TimeSpan.FromMilliseconds(o.BreakerSamplingMs),
+                BreakDuration = TimeSpan.FromMilliseconds(o.BreakDurationMs),
+                ShouldHandle = args => ValueTask.FromResult(IsTransientFailure(args.Outcome)),
+            });
+
+            // 4. Timeout - per attempt, so one hanging connection cannot eat the whole budget.
+            pipeline.AddTimeout(new HttpTimeoutStrategyOptions
+            {
+                Name = "attempt-timeout",
+                Timeout = TimeSpan.FromMilliseconds(o.AttemptTimeoutMs),
+            });
+        });
+
+        return client;
+    }
+
+    /// <summary>
+    /// What counts as a dependency failure: network errors, timeouts, 5xx, 408 and 429.
+    /// Client mistakes (4xx) and SSRF-guard rejections are the caller's fault, so they neither
+    /// trigger retries nor push the circuit breaker towards opening.
+    /// </summary>
+    internal static bool IsTransientFailure(Outcome<HttpResponseMessage> outcome)
+    {
+        if (outcome.Exception is { } ex)
+        {
+            if (RemoteUrlGuard.IsBlocked(ex)) return false;
+            return ex is HttpRequestException or TimeoutRejectedException;
+        }
+
+        if (outcome.Result is { } response)
+        {
+            var code = (int)response.StatusCode;
+            return code >= 500 || response.StatusCode is HttpStatusCode.RequestTimeout or HttpStatusCode.TooManyRequests;
+        }
+
+        return false;
+    }
+}
diff --git a/nexuscore/NexusCore.Api/Security/AuthenticationExtensions.cs b/nexuscore/NexusCore.Api/Security/AuthenticationExtensions.cs
new file mode 100644
index 0000000..6fec8d4
--- /dev/null
+++ b/nexuscore/NexusCore.Api/Security/AuthenticationExtensions.cs
@@ -0,0 +1,98 @@
+using System.Text;
+using Microsoft.AspNetCore.Authentication.JwtBearer;
+using Microsoft.IdentityModel.Tokens;
+using NexusCore.Api.Helpers;
+
+namespace NexusCore.Api.Security;
+
+public static class AuthenticationExtensions
+{
+    /// <summary>Machine-readable error codes returned in the JSON body of 401/403 responses.</summary>
+    public static class Codes
+    {
+        public const string Unauthenticated = "UNAUTHENTICATED"; // no token at all
+        public const string TokenExpired = "TOKEN_EXPIRED";
+        public const string TokenInvalid = "TOKEN_INVALID";      // bad signature, issuer, audience, malformed ...
+        public const string Forbidden = "FORBIDDEN";             // valid token, insufficient permissions
+    }
+
+    public static IServiceCollection AddNexusAuthentication(this IServiceCollection services, JwtSettings jwt)
+    {
+        services.AddSingleton(jwt);
+
+        services.AddAuthentication(JwtBearerDefaults.AuthenticationScheme)
+            .AddJwtBearer(options =>
+            {
+                // Keep JWT claim names as-is (userId, role) - default inbound mapping breaks role checks.
+                options.MapInboundClaims = false;
+                options.TokenValidationParameters = new TokenValidationParameters
+                {
+                    ValidateIssuer = true,
+                    ValidIssuer = jwt.Issuer,
+                    ValidateAudience = true,
+                    ValidAudience = jwt.Audience,
+                    ValidateLifetime = true,
+                    RequireExpirationTime = true,
+                    RequireSignedTokens = true,
+                    ValidateIssuerSigningKey = true,
+                    IssuerSigningKey = new SymmetricSecurityKey(Encoding.UTF8.GetBytes(jwt.Secret)),
+                    ValidAlgorithms = [SecurityAlgorithms.HmacSha256],
+                    ClockSkew = jwt.ClockSkew,
+                    RoleClaimType = "role",
+                    NameClaimType = "username",
+                };
+
+                options.Events = new JwtBearerEvents
+                {
+                    OnMessageReceived = context =>
+                    {
+                        if (string.IsNullOrEmpty(context.Token)
+                            && context.Request.Cookies.TryGetValue(AuthCookie.Name, out var cookieToken)
+                            && !string.IsNullOrEmpty(cookieToken))
+                        {
+                            context.Token = cookieToken;
+                            return Task.CompletedTask;
+                        }
+
+                        // SignalR/WebSockets cannot send an Authorization header from the browser.
+                        var path = context.HttpContext.Request.Path;
+                        if (string.IsNullOrEmpty(context.Token) && path.StartsWithSegments("/hubs"))
+                        {
+                            var accessToken = context.Request.Query["access_token"];
+                            if (!string.IsNullOrEmpty(accessToken))
+                                context.Token = accessToken;
+                        }
+                        return Task.CompletedTask;
+                    },
+
+                    // 401: distinguish "no token" / "expired" / "invalid" with a stable JSON body.
+                    OnChallenge = async context =>
+                    {
+                        context.HandleResponse();
+                        var (code, message) = context.AuthenticateFailure switch
+                        {
+                            null => (Codes.Unauthenticated, "Authentication required"),
+                            SecurityTokenExpiredException => (Codes.TokenExpired, "Token has expired"),
+                            _ => (Codes.TokenInvalid, "Invalid token"),
+                        };
+
+                        context.Response.StatusCode = StatusCodes.Status401Unauthorized;
+                        context.Response.Headers.WWWAuthenticate = code == Codes.Unauthenticated
+                            ? "Bearer"
+                            : $"Bearer error=\"invalid_token\", error_description=\"{message}\"";
+                        await context.Response.WriteAsJsonAsync(new { error = message, code });
+                    },
+
+                    // 403: authenticated, but role/policy requirements not met.
+                    OnForbidden = async context =>
+                    {
+                        context.Response.StatusCode = StatusCodes.Status403Forbidden;
+                        await context.Response.WriteAsJsonAsync(
+                            new { error = "Insufficient permissions", code = Codes.Forbidden });
+                    },
+                };
+            });
+
+        return services;
+    }
+}
diff --git a/nexuscore/NexusCore.Api/Security/JwtSettings.cs b/nexuscore/NexusCore.Api/Security/JwtSettings.cs
new file mode 100644
index 0000000..e8e537d
--- /dev/null
+++ b/nexuscore/NexusCore.Api/Security/JwtSettings.cs
@@ -0,0 +1,59 @@
+namespace NexusCore.Api.Security;
+
+/// <summary>
+/// Single source of truth for JWT signing/validation parameters. Used by both the token
+/// issuer (<see cref="Services.JwtTokenService"/>) and the JwtBearer validator so the two
+/// can never disagree about the secret, issuer or audience.
+/// </summary>
+public sealed class JwtSettings
+{
+    /// <summary>Only ever used when running in the Development environment with no JWT_SECRET configured.</summary>
+    public const string DevFallbackSecret = "dev-only-insecure-secret-do-not-use-in-prod-0123456789";
+
+    public const int MinSecretLength = 32;
+
+    private static readonly string[] KnownPlaceholders =
+    [
+        "change_this",
+        "change_me",
+        "nexuscore_jwt_secret_key_2025_min32chars", // value that used to be committed in appsettings.json
+    ];
+
+    public required string Secret { get; init; }
+    public string Issuer { get; init; } = "nexuscore-api";
+    public string Audience { get; init; } = "nexuscore-client";
+
+    /// <summary>Allowed clock drift when checking token expiry (default framework value is 5 minutes).</summary>
+    public TimeSpan ClockSkew { get; init; } = TimeSpan.FromSeconds(30);
+
+    public static bool IsPlaceholder(string secret) =>
+        KnownPlaceholders.Any(p => secret.Contains(p, StringComparison.OrdinalIgnoreCase));
+
+    public static JwtSettings Load(IConfiguration config, IHostEnvironment env, Action<string>? warn = null)
+    {
+        var secret = Environment.GetEnvironmentVariable("JWT_SECRET") ?? config["JWT_SECRET"];
+
+        if (string.IsNullOrWhiteSpace(secret) || secret.Length < MinSecretLength)
+        {
+            if (!env.IsDevelopment())
+                throw new InvalidOperationException(
+                    $"JWT_SECRET is missing or shorter than {MinSecretLength} characters. " +
+                    "Copy nexuscore/.env.example to nexuscore/.env and set a long random value " +
+                    "(for example: openssl rand -base64 48).");
+
+            warn?.Invoke("JWT_SECRET is not set - using an insecure development-only key.");
+            secret = DevFallbackSecret;
+        }
+        else if (IsPlaceholder(secret))
+        {
+            warn?.Invoke("JWT_SECRET still contains a placeholder value. Replace it with a random secret before deploying.");
+        }
+
+        return new JwtSettings
+        {
+            Secret = secret,
+            Issuer = Environment.GetEnvironmentVariable("JWT_ISSUER") ?? config["JWT_ISSUER"] ?? "nexuscore-api",
+            Audience = Environment.GetEnvironmentVariable("JWT_AUDIENCE") ?? config["JWT_AUDIENCE"] ?? "nexuscore-client",
+        };
+    }
+}
